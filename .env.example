# =============================================================
# LOCAL PostgreSQL (default – used when DATABASE_URL is NOT set)
# =============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=multi-store
DB_SSL=false

# =============================================================
# SUPABASE (uncomment and fill in to switch to Supabase easily)
# Get from: Supabase Dashboard → Settings → Database → Connection String
# Use Transaction pooler (port 6543) or Session pooler (port 5432)
# =============================================================
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DB_SSL=true

# Schema sync (auto-generates tables; set false in production!)
DB_SYNC=true
DB_LOGGING=false
DB_RETRY_ATTEMPTS=1
DB_RETRY_DELAY=1000

# =============================================================
# INITIAL ADMIN SEEDING (Auto-created on first application boot)
# =============================================================
ADMIN_EMAIL=admin@platform.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME="Platform Admin"

# =============================================================
# JWT AUTHENTICATION
# =============================================================
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d
SELLER_JWT_EXPIRES_IN=7d

# =============================================================
# APPLICATION & CORS
# =============================================================
PORT=4040
NODE_ENV=development
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000

# =============================================================
# RATE LIMITING (requests per TTL window in milliseconds)
# =============================================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# =============================================================
# TRANSACTIONAL EMAIL / SMTP (Nodemailer)
# (Leave empty to use built-in mock/console logging mode)
# =============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finland Marketplace" <noreply@marketplace.fi>

# =============================================================
# OBSERVABILITY (Optional)
# =============================================================
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET

# =============================================================
# STRIPE PAYMENT GATEWAY & MARKETPLACE SETTLEMENT
# =============================================================
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_replace_with_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
STRIPE_CURRENCY=USD

# Platform fee cut on every payment (percentage: 10 = 10%)
PLATFORM_FEE_PERCENT=10

# Clearance hold period in days before seller earnings become available for payout
SELLER_PAYOUT_HOLD_DAYS=14

# Minimum balance threshold in currency units required to trigger automated payout
MINIMUM_PAYOUT_AMOUNT=50

# =============================================================
# POSTI LOGISTICS & COURIER DELIVERY (Finland)
# =============================================================
# Posti Environment: test | sandbox | production
POSTI_ENVIRONMENT=test

# Posti Base API Endpoint
POSTI_API_URL=https://api.posti.fi/shipping/v1

# Posti API Key / Bearer authorization token (Posti Developer Portal)
POSTI_API_KEY=posti_test_api_key_sample_token

# Posti Contract / Customer Account Number (OmaPosti Pro customer ID)
POSTI_CUSTOMER_NUMBER=12345678

# Posti Default Service Code:
# 2103 = Postipaketti (Standard Postal Parcel to pick-up point/locker)
# 2104 = Kotipaketti (Home Parcel direct to recipient)
# 2102 = Pikkupaketti (Small parcel into letterbox)
POSTI_DEFAULT_SERVICE_CODE=2103

# Default Sender / Dispatch Workshop Information for Consignment Waybills
POSTI_SENDER_NAME="Oivaly Artisan Workshop"
POSTI_SENDER_STREET="Mannerheimintie 10"
POSTI_SENDER_POSTCODE="00100"
POSTI_SENDER_CITY="Helsinki"
POSTI_SENDER_COUNTRY="FI"

# Posti Consignment Tracking URL Template
POSTI_TRACKING_BASE_URL=https://www.posti.fi/en/tracking#/seuranta/

# =============================================================
# FINNISH PRH / YTJ OPEN DATA API (Y-tunnus Verification)
# =============================================================
PRH_YTJ_API_URL=https://avoindata.prh.fi/opendata-ytj-api/v3



